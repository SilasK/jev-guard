{
  "description": "jev-guard: assess every tool call before it runs; scan every tool result for AI-directed instructions.",
  "hooks": {
    "PreToolUse": [
      { "matcher": ".*", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/cli.js\" hook --agent codex", "timeout": 30, "statusMessage": "jev-guard: assessing tool call" }] }
    ],
    "PostToolUse": [
      { "matcher": ".*", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/src/cli.js\" hook --agent codex", "timeout": 30, "statusMessage": "jev-guard: scanning tool result" }] }
    ]
  }
}
