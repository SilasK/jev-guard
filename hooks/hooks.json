{
  "description": "jev-guard: assess every tool call before it runs; scan every tool result for AI-directed instructions. PreToolUse/PostToolUse serve Claude Code and Copilot CLI; BeforeTool/AfterTool serve Gemini CLI; each host ignores the other's keys.",
  "hooks": {
    "PreToolUse": [
      { "matcher": ".*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/cli.js\" hook", "timeout": 30 }] }
    ],
    "PostToolUse": [
      { "matcher": ".*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/cli.js\" hook", "timeout": 30 }] }
    ],
    "BeforeTool": [
      { "hooks": [{ "name": "jev-guard", "type": "command", "command": "node \"${extensionPath}/src/cli.js\" hook", "timeout": 30000 }] }
    ],
    "AfterTool": [
      { "hooks": [{ "name": "jev-guard", "type": "command", "command": "node \"${extensionPath}/src/cli.js\" hook", "timeout": 30000 }] }
    ]
  }
}
