{
  "name": "jev-guard",
  "version": "0.1.0",
  "description": "Prompt-injection and dangerous-action guard for coding agents (Claude Code, Codex, pi, ACP), powered by Jev.",
  "type": "module",
  "bin": { "jev-guard": "./src/cli.js" },
  "exports": { ".": "./src/guard.js", "./jev": "./src/jev.js" },
  "files": ["src", "extensions", "hooks", "plugin.json", ".claude-plugin", ".codex-plugin"],
  "scripts": { "test": "node --test test/*.test.js" },
  "engines": { "node": ">=20.3" },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "peerDependenciesMeta": { "@earendil-works/pi-coding-agent": { "optional": true } },
  "pi": { "extensions": ["./extensions"] },
  "keywords": ["jev", "typesafe", "prompt-injection", "security", "hooks", "claude-code", "codex", "pi-package", "acp", "mcp"],
  "author": "leepokai",
  "license": "MIT",
  "repository": "github:leepokai/jev-guard"
}
